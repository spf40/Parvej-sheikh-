.MODEL SMALL
.STACK 100H
.DATA
NUM1 DB 5
NUM2 DB 3
RESULT DB ?

.CODE
MAIN PROC
    MOV AX, @DATA
    MOV DS, AX          ; initialize data segment

    MOV AL, NUM1        ; AL = NUM1
    ADD AL, NUM2        ; AL = AL + NUM2
    MOV RESULT, AL      ; store result

    ADD AL, 30H         ; convert to ASCII
    MOV DL, AL          ; move result to DL
    MOV AH, 02H         ; function to display character
    INT 21H             ; display result on screen

    MOV AH, 4CH         ; terminate program
    INT 21H

MAIN ENDP
END MAIN
